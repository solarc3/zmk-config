#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &kp TAB    &kp Q    &kp W    &kp E    &kp R    &kp T
                &kp Y      &kp U    &kp I    &kp O    &kp P    &kp BSPC

                &mo 1      &kp A    &kp S    &kp D    &kp F    &kp G
                &kp H      &kp J    &kp K    &kp L    &kp SEMI &kp ENTER

                &kp LSHFT  &kp Z    &kp X    &kp C    &kp V    &kp B
                &kp N      &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT

                &kp LCTRL  &kp LGUI &mt LCTRL SPACE
                &lt 2 RGUI &none    &kp RCTRL
            >;
        };

        lower {
            bindings = <
                &kp ESC    &kp N1          &kp N2    &kp N3    &kp N4    &kp N5
                &kp N6     &kp N7          &kp N8    &kp N9    &kp N0    &kp DEL

                &trans     &kp PRINTSCREEN &trans    &kp LBKT  &kp RBKT  &trans
                &kp LEFT   &kp DOWN        &kp UP    &kp RIGHT &kp SEMI  &kp SQT

                &kp LSHFT  &kp CAPSLOCK    &trans    &trans    &trans    &kp BSLH
                &kp KP_MULTIPLY &kp MINUS  &kp EQUAL &kp EQUAL &kp FSLH &kp RSHFT

                &trans &trans &trans
                &trans &trans &trans
            >;
        };

        function {
            bindings = <
                &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6
                &kp F7   &kp F8   &kp F9   &kp F10  &kp F11  &kp F12

                &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1
                &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4

                &none &none &none &none &none &kp C_VOLUME_UP

                &studio_unlock &none &none &none &none &bootloader
                &none &none &kp RALT &kp RCTRL &kp DEL &kp C_VOLUME_DOWN

                &trans &trans &trans
                &trans &trans &trans
            >;
        };
    };
};
